# Copy to ~/.config/systemd/user/open-asset-lab.service and replace paths.
# The token is generated by `python -m assetlab access` in the library root.
[Unit]
Description=Open Asset Lab private Tailscale service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/open-asset-lab
ExecStart=/path/to/open-asset-lab/.venv/bin/python -m assetlab serve --tailscale --source-dir /private/path/to/maps --vpk /private/path/to/tf2_misc_dir.vpk --vpk /private/path/to/tf2_textures_dir.vpk
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
